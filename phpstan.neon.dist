parameters:
    level: 5

    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # MyCLabs enum constants are read through reflection and __callStatic().
        -
            identifier: classConstant.unused
            message: '#^Constant Paddle\\SDK\\(?:Entities|Notifications\\Entities|Resources)\\.+::[a-zA-Z_][a-zA-Z0-9_]* is unused\.$#'
